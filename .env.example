# ==============================================================================
# TrustVault - Environment Configuration Template
# Copy this file to '.env' and set strong, random values in production.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
FLASK_ENV=development
FLASK_DEBUG=0

# Secret Key for Session Signing and CSRF (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Database Configuration
# Local SQLite example: sqlite:///instance/trustvault.db
# Production PostgreSQL example: postgresql://trustvault_user:strong_password@localhost:5432/trustvault_prod
DATABASE_URL=sqlite:///instance/trustvault.db

# Storage Directory for Uploaded Encrypted Documents (relative to project root or absolute path)
STORAGE_PATH=storage/tenants

# Maximum Upload Size in Bytes (Default: 10485760 = 10 MB)
MAX_CONTENT_LENGTH=10485760

# Session Cookie Security (Enforce 1 in production with HTTPS)
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=3600
